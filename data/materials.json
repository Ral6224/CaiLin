    {
      "id": "4f4f0998-cd69-4fca-8111-fdb5d8e53cad",
      "person": "杜甫",
      "identity": "唐代诗人",
      "deeds": "亲历安史之乱，携家流亡，将所见所感写入“三吏”“三别”。寓居成都草堂时，茅屋为秋风所破，仍推己及人，写下“安得广厦千万间”的呼喊。其诗被后世称为“诗史”。",
      "quote": "安得广厦千万间，大庇天下寒士俱欢颜。",
      "source": "《茅屋为秋风所破歌》",
      "spirit": "忧国忧民，悲悯苍生；以诗笔记录时代，把个人苦难化为对天下人的关怀。",
      "topics": [
        "家国情怀",
        "人民立场",
        "苦难与担当",
        "现实主义"
      ],
      "keywords": [
        "诗圣",
        "诗史",
        "草堂",
        "安史之乱"
      ],
      "createdAt": "2026-10-26T12:56:04.196Z",
      "updatedAt": "2026-10-26T12:56:04.196Z"
    },
    {
      "id": "60dd840c-56af-4a08-b233-f3bc4ffba2c1",
      "person": "袁隆平",
      "identity": "杂交水稻育种专家",
      "deeds": "数十年扎根田间，攻克杂交水稻育种难题，推动水稻大幅增产。晚年仍奔走在试验田与推广一线，培养青年科研人员，让“禾下乘凉梦”从愿望走向现实。",
      "quote": "人就像种子，要做一粒好种子。",
      "source": "袁隆平寄语",
      "spirit": "躬耕实践，潜心钻研；以科学造福苍生，把论文写在祖国大地上。",
      "topics": [
        "科技报国",
        "粮食安全",
        "坚守",
        "实干"
      ],
      "keywords": [
        "杂交水稻",
        "禾下乘凉梦",
