    {
      "id": "48154a6b-07df-4881-89e5-7f8af931a4ef",
      "person": "司马迁",
      "identity": "西汉史学家、文学家",
      "deeds": "继承父志撰写史书，因李陵之祸受宫刑。他忍辱负重，发愤著书，遍访旧闻、考订史实，最终完成中国第一部纪传体通史《史记》。",
      "quote": "人固有一死，或重于泰山，或轻于鸿毛。",
      "source": "《报任安书》",
      "spirit": "忍辱负重，矢志不渝；秉笔直书，以求真之志守护历史。",
      "topics": [
        "逆境",
        "使命",
        "求真",
        "历史与书写"
      ],
      "keywords": [
        "史记",
        "太史公",
        "纪传体",
        "发愤著书"
      ],
      "createdAt": "2026-10-26T12:56:04.196Z",
      "updatedAt": "2026-10-26T12:56:04.196Z"
