    {
      "id": "79940899-78af-45f1-b9a6-78ec9066ebb4",
      "person": "屈原",
      "identity": "战国时期楚国诗人、政治家",
      "deeds": "曾任楚国左徒，主张举贤授能、联齐抗秦，遭排挤流放。行吟泽畔，仍心系故国，写下《离骚》《九歌》《天问》等作品，以生命守护理想与高洁。",
      "quote": "路漫漫其修远兮，吾将上下而求索。",
      "source": "《离骚》",
      "spirit": "忠贞爱国，洁身自好；为理想上下求索，九死未悔。",
      "topics": [
        "家国",
        "理想与气节",
        "求索",
        "文化传承"
      ],
      "keywords": [
        "楚辞",
        "离骚",
        "汨罗江",
        "端午"
      ],
